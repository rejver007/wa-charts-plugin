{
	"name": "wa-charts",
	"version": "1.1.2",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"env": "wp-env",
		"composer": "wp-env run tests-cli --env-cwd=wp-content/plugins/wa-charts composer",
		"wp": "wp-env run cli --env-cwd=wp-content/plugins/wa-charts wp",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wa-charts vendor/bin/phpunit",
		"lint:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wa-charts vendor/bin/phpcs",
		"test:js": "wp-scripts test-unit-jest tests/js",
		"lint:js": "wp-scripts lint-js assets/front assets/admin src tests/js bin",
		"format": "wp-scripts format assets/front assets/admin src tests/js bin",
		"build": "wp-scripts build --webpack-src-dir=src --output-path=build",
		"vendor": "node bin/copy-vendor.js",
		"makepot": "wp-env run cli --env-cwd=wp-content/plugins/wa-charts wp i18n make-pot . languages/wa-charts.pot --exclude=node_modules,vendor,tests,src,docs,bin"
	},
	"devDependencies": {
		"@wordpress/block-editor": "18.0.0",
		"@wordpress/blocks": "16.1.0",
		"@wordpress/components": "41.0.0",
		"@wordpress/core-data": "8.1.0",
		"@wordpress/data": "10.56.0",
		"@wordpress/element": "8.8.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/i18n": "6.29.0",
		"@wordpress/scripts": "36.0.0",
		"@wordpress/url": "4.56.0",
		"chart.js": "4.5.1",
		"chartjs-plugin-datalabels": "2.2.0",
		"jest": "30.5.2"
	},
	"volta": {
		"node": "22.23.3"
	}
}
