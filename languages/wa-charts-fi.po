#. Plugin Name of the plugin
#: wa-charts.php
msgid "WebAula Charts"
msgstr "WebAula Charts"

#. Description of the plugin
#: wa-charts.php
msgid "Charts as a custom post type, shown with a shortcode or block. Replaces Graphina."
msgstr "Kaaviot omana sisältötyyppinään, näytetään lyhytkoodilla tai lohkolla. Korvaa Graphinan."

